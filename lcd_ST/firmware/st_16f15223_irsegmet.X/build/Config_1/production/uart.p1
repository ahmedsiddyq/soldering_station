"6
[; ;uart.c: 6: {
{
[e :U _UART_Init ]
"5
[; ;uart.c: 5: void UART_Init(uint32_t baud)
[v _baud `ul ~T0 @X0 1 r1 ]
"6
[; ;uart.c: 6: {
[f ]
"7
[; ;uart.c: 7:     BAUD1CONbits.BRG16 = 1;
[e = . . _BAUD1CONbits 0 3 -> -> 1 `i `uc ]
"8
[; ;uart.c: 8:     TX1STAbits.BRGH = 1;
[e = . . _TX1STAbits 0 2 -> -> 1 `i `uc ]
"9
[; ;uart.c: 9:     TX1STAbits.SYNC = 0;
[e = . . _TX1STAbits 0 4 -> -> 0 `i `uc ]
"11
[; ;uart.c: 11:     uint32_t spbrg = (32000000UL / (4UL * baud)) - 1;
[v _spbrg `ul ~T0 @X0 1 a ]
[e = _spbrg - / -> 32000000 `ul * -> 4 `ul _baud -> -> -> 1 `i `l `ul ]
"12
[; ;uart.c: 12:     SP1BRGL = (uint8_t)(spbrg & 0xFF);
[e = _SP1BRGL -> & _spbrg -> -> -> 255 `i `l `ul `uc ]
"13
